digraph G {
  graph [rankdir=TB, bgcolor="white", pad="0.18", nodesep="0.32", ranksep="0.46", fontname="Noto Sans CJK SC"];
  node [shape=box, style="rounded,filled", color="#35536B", fillcolor="#F7FAFC", penwidth=1.2, fontname="Noto Sans CJK SC", fontsize=10, margin="0.10,0.07"];
  edge [color="#526B7A", penwidth=1.2, arrowsize=0.7, fontname="Noto Sans CJK SC", fontsize=9];

  base [label="基础 ETP-R1\n指令 + 在线拓扑图\n基础动作分数", fillcolor="#EAF2F8"];
  topk [label="稳定 Top-K ghost\n主设置 K=5"];
  hist [label="四帧历史快照\n原生 CLS + 256 patch", fillcolor="#FFF8E7"];
  q0 [label="冻结 RAE-NWM\n候选到达表征 q0", fillcolor="#EDF7ED"];
  cwp [label="冻结候选航点预测器\n局部位移与朝向", fillcolor="#EDF7ED"];
  q1 [label="冻结 RAE-NWM\n候选前方一步 q1", fillcolor="#EDF7ED"];
  adapter [label="CLS 适配器\n仅修改 token 0", fillcolor="#FDEDEC"];
  head [label="候选残差评分头\n指令 / patch / CLS / 几何\n|delta| <= 1", fillcolor="#FDEDEC"];
  output [label="动作对齐残差\nSTOP 与非 Top-K 不直接加残差\n失败槽 delta=0", fillcolor="#EAF2F8"];
  cache [label="GRPO rollout 缓存\n残差 + 有效掩码 + 旧概率", fillcolor="#F4ECF7"];
  h23 [label="计划扩展 h=2,3\n固定历史 + 累计位姿条件\n仅端点进入评分头", style="rounded,dashed,filled", color="#9A7D0A", fillcolor="#FFFDF2"];

  { rank=same; base; hist; }
  { rank=same; topk; q0; cwp; q1; }
  { rank=same; adapter; head; output; }
  { rank=same; h23; cache; }

  base -> topk;
  hist -> q0;
  topk -> q0 [label="逐候选条件"];
  q0 -> cwp;
  cwp -> q1;
  hist -> q1 [label="同一来源快照"];
  q1 -> adapter;
  adapter -> head;
  topk -> head [label="候选表示与基础分数"];
  base -> head [label="指令表示", constraint=false];
  head -> output;
  output -> cache [label="强化阶段"];
  q1 -> h23 [style=dashed, color="#9A7D0A"];
  h23 -> head [style=dashed, color="#9A7D0A"];
}
