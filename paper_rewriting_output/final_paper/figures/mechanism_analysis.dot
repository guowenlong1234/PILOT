digraph G {
  graph [rankdir=LR, bgcolor="white", pad="0.18", nodesep="0.34", ranksep="0.48", fontname="Noto Sans CJK SC"];
  node [shape=box, style="rounded,filled", color="#35536B", fillcolor="#F7FAFC", penwidth=1.2, fontname="Noto Sans CJK SC", fontsize=10, margin="0.12,0.08"];
  edge [color="#526B7A", penwidth=1.25, arrowsize=0.75, fontname="Noto Sans CJK SC", fontsize=9];

  factors [label="受控变量\n视野 h = 1 / 2 / 3\n候选 K = 1 / 3 / 5 / 10\n历史 L = 1 / 2 / 4", fillcolor="#EAF2F8"];
  quality [label="预测质量\nCLS 余弦距离\npatch 平均余弦距离", fillcolor="#EDF7ED"];
  coverage [label="有效覆盖\n有效未来槽 / Top-K 槽\n按失败原因与决策步分层", fillcolor="#EDF7ED"];
  cost [label="计算成本\n分模块延迟\n端到端延迟与峰值显存", fillcolor="#FFF8E7"];
  behavior [label="动作干预\n平均绝对残差\n翻转率\nSTOP<->MOVE 类型", fillcolor="#FDEDEC"];
  outcome [label="导航结果\nSR / SPL / nDTW / SDTW\n配对置信区间", fillcolor="#F4ECF7"];
  audit [label="解释边界\n报告样本数与分母\n相关性不等于单步因果", fillcolor="#F7F7F7"];

  factors -> quality;
  factors -> coverage;
  factors -> cost;
  quality -> behavior;
  coverage -> behavior;
  behavior -> outcome;
  cost -> outcome [label="性能-成本权衡"];
  outcome -> audit;
}
